  <DialogueName>k__BackingField: Luis0
  <Text>k__BackingField: "\xA1Fue la mejor noche! \xBFQu\xE9 opinas Renato?"
  <Actor>k__BackingField: Luis
  <Choices>k__BackingField:
  - <Text>k__BackingField: "Fue la noche m\xE1s feliz de mi vida\u2026 creo que nunca
      me hab\xEDa sentido como ayer"
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: b7a4b8adf3639304990d31b2f306e00e, type: 2}
  - <Text>k__BackingField: "Me sent\xED tan feliz que pens\xE9 que estaba en otro
      mundo"
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: b7a4b8adf3639304990d31b2f306e00e, type: 2}
