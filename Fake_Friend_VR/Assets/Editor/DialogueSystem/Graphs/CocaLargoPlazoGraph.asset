    <Choices>k__BackingField:
    - <Text>k__BackingField: "\xA1\xA1Ahhh pucha mam\xE1. nunca me apoyas!!"
      <NodeID>k__BackingField: affeb86a-560c-4de9-963c-df7005c1449d
    - <Text>k__BackingField: "\xA1\xA1Cortala con los sermones y dame plata!!"
