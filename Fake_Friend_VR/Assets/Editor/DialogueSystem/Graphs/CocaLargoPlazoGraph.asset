  - <ID>k__BackingField: 1de11d1f-4323-4040-ad9a-e0cff9f8488e
    <Name>k__BackingField: Mama1
    <Text>k__BackingField: "\xBFQu\xE9 pasa hijito?"
    <Actor>k__BackingField: Mama
    <Choices>k__BackingField:
    - <Text>k__BackingField: "Mam\xE1, \xBFDame plata para unos completos?"
